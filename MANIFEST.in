# Keep source distributions reproducible from a dirty development checkout.
prune tmp
prune cache
prune cache*
prune outputs
prune output
prune data/hfd_datasets
prune data/bench_results
prune data/benchmark_zoo
prune assets/datasets
prune assets/repos
prune worldfoundry/data/test_cases
prune docs/fumadocs/.next
prune docs/fumadocs/out
prune docs/fumadocs/node_modules
prune worldfoundry/studio/assets/vendor

# License-gated upstream runtimes; LICENSE_GATED_PATHS in
# scripts/setup/check_packaging_license_gate.py owns this list.
prune worldfoundry/base_models/three_dimensions/depth/dvlt/dvlt_runtime
prune worldfoundry/base_models/three_dimensions/depth/unik3d
prune worldfoundry/base_models/three_dimensions/general_3d/dust3r
prune worldfoundry/base_models/three_dimensions/general_3d/four_d_gaussians
prune worldfoundry/base_models/three_dimensions/general_3d/mast3r
prune worldfoundry/base_models/three_dimensions/general_3d/monst3r
prune worldfoundry/base_models/three_dimensions/general_3d/stable_virtual_camera
prune worldfoundry/base_models/three_dimensions/point_clouds/gaussian_splatting
prune worldfoundry/base_models/three_dimensions/point_clouds/pi3
prune worldfoundry/base_models/three_dimensions/slam/mega_sam_runtime/UniDepth
prune worldfoundry/synthesis/visual_generation/hunyuan_world/hunyuan_game_craft
prune worldfoundry/synthesis/visual_generation/hunyuan_world/hunyuan_world_voyager
prune worldfoundry/synthesis/visual_generation/hunyuan_world/hy_world_2p0_panogen_runtime
prune worldfoundry/synthesis/visual_generation/hunyuan_world/hy_world_2p0_worldgen_runtime
prune worldfoundry/synthesis/visual_generation/krea_realtime/realtime_video_runtime
prune worldfoundry/synthesis/visual_generation/open_sora/open_sora_runtime
prune worldfoundry/synthesis/visual_generation/vmem/vmem_runtime/extern/CUT3R
prune worldfoundry/synthesis/visual_generation/wonderworld/wonderworld_runtime
prune thirdparty/diff-gaussian-rasterization
prune thirdparty/SageAttention
prune thirdparty/simple-knn
prune thirdparty/matrix-game

# Upstream runtime mirrors should ship source code, not demo galleries, notebooks,
# eval question dumps, or bundled sample media.
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
global-exclude *.7z *.arrow *.bz2 *.ckpt *.feather *.gguf *.gz *.h5 *.hdf5
global-exclude *.gif *.ipynb *.pdf
global-exclude *.mlmodel *.mp4 *.npy *.npz *.onnx *.parquet *.pickle *.pkl
global-exclude *.pt *.pth *.rar *.safetensors *.sqlite *.sqlite3 *.tar *.tgz *.zip *.zst

# Public source contains inference and evaluation only.
prune worldfoundry/training
exclude worldfoundry/cli/training.py
prune worldfoundry/cli/training_commands
prune scripts/training
prune configs/training
prune configs/post_training
prune test
prune tests
prune test_stream
exclude pytest.ini
exclude docs/fumadocs/content/docs/guides/training.mdx
exclude docs/fumadocs/content/docs/guides/training.zh.mdx
global-exclude */test/* */tests/* */testing/* conftest.py pytest.ini

prune testcase
global-exclude test_*.py *_test.py test_*.cpp *_test.cpp

# Publish first-party test sources and fixtures in sdists, after the upstream
# QA exclusions above. Wheels continue to contain only worldfoundry packages.
recursive-include tests *.py *.mjs *.md *.sh *.yaml *.yml *.json *.jsonl
include docs/fumadocs/public/measurements/mg2-conditioned-trajectory-2026-10-03.json
# First-party packaging helper exercised by the published license tests.
include thirdparty/fastvideo-kernel/build_backend.py
include .github/workflows/ci.yml
include .github/workflows/pr-checks.yml
recursive-include scripts/dev *.py
include Makefile scripts/setup/check_packaging_license_gate.py
global-exclude */__pycache__/* */.pytest_cache/* */.mypy_cache/* */.ruff_cache/*
global-exclude */tmp/* */temp/* */logs/* */outputs/* .env*

# Required iWorld-Bench camera trajectories (the only NumPy archives in package data).
recursive-include worldfoundry/data/benchmarks/assets/iworld-bench/camera_trajectories *.npz
